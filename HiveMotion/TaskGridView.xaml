<UserControl x:Class="HiveMotion.TaskGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei">
    <Grid x:Name="Root" SizeChanged="OnRootSizeChanged">
        <!-- 桌面截图 + 高斯模糊(还原演示的 backdrop blur) -->
        <Image x:Name="BackdropImage" Stretch="Fill" IsHitTestVisible="False">
            <Image.Effect>
                <BlurEffect Radius="16" RenderingBias="Performance" />
            </Image.Effect>
        </Image>

        <!-- 压暗层(点击空白处关闭) -->
        <Border Background="#8010131A" MouseLeftButtonDown="OnBackdropClick" />

        <!-- 蜂蜜色径向辉光 -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.42" RadiusX="0.9" RadiusY="0.7">
                    <GradientStop Color="#12F5B301" Offset="0" />
                    <GradientStop Color="#00F5B301" Offset="0.6" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- 顶部提示 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,32,0,0" IsHitTestVisible="False">
            <Border Width="32" Height="1" VerticalAlignment="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00F5B301" Offset="0" />
                        <GradientStop Color="#B3F5B301" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <TextBlock Text="点 击 六 边 形 , 或 按 下 对 应 字 母 切 换 窗 口"
                       FontSize="13" Foreground="#8CFFFFFF" Margin="10,0" />
            <Border Width="32" Height="1" VerticalAlignment="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#B3F5B301" Offset="0" />
                        <GradientStop Color="#00F5B301" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </StackPanel>

        <!-- 中央:蜂巢网格 + 搜索面板 -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Viewbox x:Name="HiveBox" Stretch="Uniform" StretchDirection="DownOnly">
                <Grid Width="1470" Height="460">
                    <Canvas x:Name="HexCanvas" Width="1410" Height="400" />
                </Grid>
            </Viewbox>

            <Canvas x:Name="SearchArea" Width="460" Height="48" Margin="0,28,0,0">
                <!-- 向上拉出的搜索列表 -->
                <Border x:Name="ResultPanel" Canvas.Left="0" Canvas.Bottom="60"
                        Width="460" MaxHeight="340" CornerRadius="16"
                        Background="#E614161D" BorderBrush="#47F5B301" BorderThickness="1"
                        Visibility="Collapsed" Opacity="0">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="32" ShadowDepth="12" />
                    </Border.Effect>
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ResultPanelSlide" Y="24" />
                    </Border.RenderTransform>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="340">
                        <StackPanel Margin="6">
                            <StackPanel x:Name="ResultHeader" Orientation="Horizontal" Margin="8,8,8,4">
                                <Ellipse Width="4" Height="4" Fill="#F5B301" VerticalAlignment="Center" />
                                <TextBlock x:Name="ResultHeaderText" Text="全 部 窗 口"
                                           FontSize="11" Foreground="#99F5C542" Margin="8,0,0,0" />
                            </StackPanel>
                            <StackPanel x:Name="ResultList" />
                            <TextBlock x:Name="ResultEmpty" Text="没 有 匹 配 的 窗 口" Visibility="Collapsed"
                                       FontSize="13" Foreground="#59FFFFFF" HorizontalAlignment="Center" Margin="0,20" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- 空格键造型的长条 / 搜索输入框 -->
                <Border x:Name="SpaceBar" Canvas.Left="0" Canvas.Bottom="0" Width="460" Height="48"
                        CornerRadius="10" BorderThickness="1"
                        Cursor="Hand"
                        MouseLeftButtonDown="OnSpaceBarClick">
                    <Border.Background>
                        <LinearGradientBrush x:Name="SpaceBarBrush" StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1AFFFFFF" Offset="0" />
                            <GradientStop Color="#0DFFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <SolidColorBrush x:Name="SpaceBarBorderBrush" Color="#33FFFFFF" />
                    </Border.BorderBrush>
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="16" ShadowDepth="4" />
                    </Border.Effect>
                    <Grid>
                        <Border x:Name="SpaceBarRidge" VerticalAlignment="Bottom" Height="3"
                                Margin="1,0,1,1" CornerRadius="0,0,9,9" Background="#59F5B301" Opacity="0.6" />

                        <!-- 空闲态 -->
                        <StackPanel x:Name="BarIdle" Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Border Width="16" Height="1" Background="#99F5B301" VerticalAlignment="Center" />
                            <TextBlock Text="按 下 空 格 搜 索" FontSize="14" Foreground="#BFFFFFFF" Margin="12,0" />
                            <Border Width="16" Height="1" Background="#99F5B301" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- 搜索态 -->
                        <Grid x:Name="BarSearch" Visibility="Collapsed" Margin="14,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Canvas Width="16" Height="16" VerticalAlignment="Center">
                                <Ellipse Width="11" Height="11" Canvas.Left="0.5" Canvas.Top="0.5"
                                         Stroke="#CCF5C542" StrokeThickness="2" />
                                <Line X1="9.5" Y1="9.5" X2="15" Y2="15"
                                      Stroke="#CCF5C542" StrokeThickness="2" StrokeStartLineCap="Round" />
                            </Canvas>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="QueryText" FontSize="15" Foreground="White" VerticalAlignment="Center" />
                                <Border x:Name="Caret" Width="2" Height="18" Background="#F5C542" Margin="2,0,0,0" VerticalAlignment="Center">
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.1" Duration="0:0:0.53" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>
                                <TextBlock x:Name="QueryPlaceholder" Text="输 入 窗 口 标 题 或 应 用 名 …"
                                           FontSize="14" Foreground="#59FFFFFF" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Grid.Column="2" Padding="6,2" CornerRadius="4"
                                    BorderBrush="#59F5B301" BorderThickness="1" Background="#14F5B301"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Esc 退 出" FontSize="10" Foreground="#B3FFD97A" />
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Canvas>
        </StackPanel>

        <!-- 底部提示 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,28" IsHitTestVisible="False">
            <Border Padding="6,2" CornerRadius="4" BorderBrush="#59F5B301" BorderThickness="1" Background="#14F5B301" VerticalAlignment="Center">
                <TextBlock Text="A" FontSize="11" Foreground="#CCFFD97A" />
            </Border>
            <TextBlock Text="~" FontSize="11" Foreground="#66FFFFFF" VerticalAlignment="Center" Margin="3,0" />
            <Border Padding="6,2" CornerRadius="4" BorderBrush="#59F5B301" BorderThickness="1" Background="#14F5B301" VerticalAlignment="Center">
                <TextBlock Text="Z" FontSize="11" Foreground="#CCFFD97A" />
            </Border>
            <TextBlock Text="直 达 窗 口" FontSize="12" Foreground="#66FFFFFF" VerticalAlignment="Center" Margin="6,0,20,0" />

            <Border Padding="12,2" CornerRadius="4" BorderBrush="#59F5B301" BorderThickness="1" Background="#14F5B301" VerticalAlignment="Center">
                <TextBlock Text="空 格" FontSize="11" Foreground="#CCFFD97A" />
            </Border>
            <TextBlock Text="搜 索" FontSize="12" Foreground="#66FFFFFF" VerticalAlignment="Center" Margin="6,0,20,0" />

            <Border Padding="6,2" CornerRadius="4" BorderBrush="#59F5B301" BorderThickness="1" Background="#14F5B301" VerticalAlignment="Center">
                <TextBlock Text="Esc" FontSize="11" Foreground="#CCFFD97A" />
            </Border>
            <TextBlock x:Name="EscHintText" Text="关 闭" FontSize="12" Foreground="#66FFFFFF" VerticalAlignment="Center" Margin="6,0,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
