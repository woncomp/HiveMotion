<UserControl x:Class="HiveMotion.TaskGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:HiveMotion.Localization"
             FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei">
    <Grid x:Name="Root" SizeChanged="OnRootSizeChanged">
        <!-- Desktop screenshot (blur is baked into the pixels at capture time, no shader needed) -->
        <Image x:Name="BackdropImage" Stretch="Fill" IsHitTestVisible="False" />

        <!-- Dimming layer (clicking the empty area closes) -->
        <Border Background="#8010131A" MouseLeftButtonDown="OnBackdropClick" />

        <!-- Honey-colored radial glow -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.42" RadiusX="0.9" RadiusY="0.7">
                    <GradientStop Color="#12F5B301" Offset="0" />
                    <GradientStop Color="#00F5B301" Offset="0.6" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Center: hive grid + search panel -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Viewbox x:Name="HiveBox" Stretch="Uniform" StretchDirection="DownOnly">
                <Grid Width="1470" Height="460">
                    <Canvas x:Name="HexCanvas" Width="1410" Height="400" />
                </Grid>
            </Viewbox>

            <Canvas x:Name="SearchArea" Width="552" Height="48" Margin="0,28,0,0">
                <!-- Search result list that pulls upward -->
                <Border x:Name="ResultPanel" Canvas.Left="0" Canvas.Bottom="60"
                        Width="552" MaxHeight="340" CornerRadius="16"
                        Background="#E614161D" BorderBrush="#47F5B301" BorderThickness="1"
                        Visibility="Collapsed" Opacity="0">
                    <Border.CacheMode>
                        <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="False" />
                    </Border.CacheMode>
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="32" ShadowDepth="12" />
                    </Border.Effect>
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ResultPanelSlide" Y="24" />
                    </Border.RenderTransform>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="340">
                        <ScrollViewer.Resources>
                            <Style x:Key="NarrowScrollThumb" TargetType="Thumb">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="2" Background="#3DFFFFFF" Margin="1,2,0,2" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style TargetType="ScrollBar">
                                <Setter Property="Width" Value="5" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ScrollBar">
                                            <Border Background="Transparent">
                                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                    <Track.Thumb>
                                                        <Thumb Style="{StaticResource NarrowScrollThumb}" />
                                                    </Track.Thumb>
                                                </Track>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ScrollViewer.Resources>
                        <StackPanel Margin="6">
                            <StackPanel x:Name="ResultHeader" Orientation="Horizontal" Margin="8,8,8,4">
                                <Ellipse Width="4" Height="4" Fill="#F5B301" VerticalAlignment="Center" />
                                <TextBlock x:Name="ResultHeaderText" Text="All windows"
                                           FontSize="11" Foreground="#99F5C542" Margin="8,0,0,0" />
                            </StackPanel>
                            <StackPanel x:Name="ResultList" />
                            <TextBlock x:Name="ResultEmpty" Text="{l:Loc Grid_NoMatches}" Visibility="Collapsed"
                                       FontSize="13" Foreground="#59FFFFFF" HorizontalAlignment="Center" Margin="0,20" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Copy-success toast: floats at the bottom of the list, fades out automatically -->
                <Border x:Name="CopyToast" Canvas.Left="0" Canvas.Bottom="64" Width="552"
                        Opacity="0" IsHitTestVisible="False">
                    <Border HorizontalAlignment="Center" Padding="14,5" CornerRadius="8"
                            Background="#F214161D" BorderBrush="#59F5B301" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="16" ShadowDepth="6" />
                        </Border.Effect>
                        <TextBlock x:Name="CopyToastText" FontSize="12" Foreground="#CCFFD97A" />
                    </Border>
                </Border>

                <!-- Spacebar-shaped bar / search input -->
                <Border x:Name="SpaceBar" Canvas.Left="0" Canvas.Bottom="0" Width="552" Height="48"
                        CornerRadius="10" BorderThickness="1"
                        Cursor="Hand"
                        MouseLeftButtonDown="OnSpaceBarClick">
                    <Border.Background>
                        <LinearGradientBrush x:Name="SpaceBarBrush" StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1AFFFFFF" Offset="0" />
                            <GradientStop Color="#0DFFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <SolidColorBrush x:Name="SpaceBarBorderBrush" Color="#33FFFFFF" />
                    </Border.BorderBrush>
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="16" ShadowDepth="4" />
                    </Border.Effect>
                    <Grid>
                        <Border x:Name="SpaceBarRidge" VerticalAlignment="Bottom" Height="3"
                                Margin="1,0,1,1" CornerRadius="0,0,9,9" Background="#59F5B301" Opacity="0.6" />

                        <!-- Idle state -->
                        <StackPanel x:Name="BarIdle" Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Border Width="16" Height="1" Background="#99F5B301" VerticalAlignment="Center" />
                            <TextBlock Text="{l:Loc Grid_PressSpace}" FontSize="14" Foreground="#BFFFFFFF" Margin="12,0" />
                            <Border Width="16" Height="1" Background="#99F5B301" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Search state: a real input box with the system's default editing and IME behavior -->
                        <Grid x:Name="BarSearch" Visibility="Collapsed" Margin="14,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Canvas Width="16" Height="16" VerticalAlignment="Center">
                                <Ellipse Width="11" Height="11" Canvas.Left="0.5" Canvas.Top="0.5"
                                         Stroke="#CCF5C542" StrokeThickness="2" />
                                <Line X1="9.5" Y1="9.5" X2="15" Y2="15"
                                      Stroke="#CCF5C542" StrokeThickness="2" StrokeStartLineCap="Round" />
                            </Canvas>
                            <Grid Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBox x:Name="SearchInput"
                                         Background="Transparent" BorderThickness="0"
                                         FontSize="15" Foreground="White" CaretBrush="#F5C542"
                                         VerticalContentAlignment="Center"
                                         TextChanged="OnSearchTextChanged"
                                         PreviewKeyDown="OnSearchInputPreviewKeyDown" />
                                <TextBlock x:Name="QueryPlaceholder" Text="{l:Loc Grid_SearchPlaceholder}"
                                           FontSize="14" Foreground="#59FFFFFF"
                                           VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                            <Border Grid.Column="2" Padding="6,2" CornerRadius="4"
                                    BorderBrush="#59F5B301" BorderThickness="1" Background="#14F5B301"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{l:Loc Grid_EscExit}" FontSize="10" Foreground="#B3FFD97A" />
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Canvas>
        </StackPanel>

        <!-- Hover window preview: right above the hive area, shared by all apps (topmost);
             content flush with the edges. Pinned cells that are not running show no thumbnail,
             just the app name and full command line. -->
        <Border x:Name="HoverPreview" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,28,0,0"
                CornerRadius="6" BorderBrush="#59F5B301" BorderThickness="1"
                Background="#E614161D"
                Opacity="0" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.55" BlurRadius="30" ShadowDepth="14" />
            </Border.Effect>
            <Grid>
                <Border x:Name="HoverPreviewViewport" CornerRadius="5" Background="Transparent" />
                <StackPanel x:Name="LaunchInfoPanel" Visibility="Collapsed" Margin="20,14" MaxWidth="560">
                    <TextBlock x:Name="LaunchInfoName" FontSize="15" FontWeight="SemiBold"
                               Foreground="#F2FFFFFF" />
                    <TextBlock x:Name="LaunchInfoCommand" FontSize="12" Foreground="#99FFFFFF"
                               Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               MaxHeight="60" />
                    <TextBlock x:Name="LaunchInfoHint" Text="{l:Loc Cell_ClickToLaunch}" FontSize="10" Foreground="#CCF5C542" Margin="0,10,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bottom hints -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,28" IsHitTestVisible="False">
            <Border Padding="6,2" CornerRadius="4" BorderBrush="#59F5B301" BorderThickness="1" Background="#14F5B301" VerticalAlignment="Center">
                <TextBlock Text="A" FontSize="11" Foreground="#CCFFD97A" />
            </Border>
            <TextBlock Text="~" FontSize="11" Foreground="#66FFFFFF" VerticalAlignment="Center" Margin="3,0" />
            <Border Padding="6,2" CornerRadius="4" BorderBrush="#59F5B301" BorderThickness="1" Background="#14F5B301" VerticalAlignment="Center">
                <TextBlock Text="Z" FontSize="11" Foreground="#CCFFD97A" />
            </Border>
            <TextBlock Text="{l:Loc Grid_HintJump}" FontSize="12" Foreground="#66FFFFFF" VerticalAlignment="Center" Margin="6,0,20,0" />

            <Border Padding="12,2" CornerRadius="4" BorderBrush="#59F5B301" BorderThickness="1" Background="#14F5B301" VerticalAlignment="Center">
                <TextBlock Text="{l:Loc Grid_KeySpace}" FontSize="11" Foreground="#CCFFD97A" />
            </Border>
            <TextBlock Text="{l:Loc Grid_HintSearch}" FontSize="12" Foreground="#66FFFFFF" VerticalAlignment="Center" Margin="6,0,20,0" />

            <Border Padding="6,2" CornerRadius="4" BorderBrush="#59F5B301" BorderThickness="1" Background="#14F5B301" VerticalAlignment="Center">
                <TextBlock Text="Ctrl+P" FontSize="11" Foreground="#CCFFD97A" />
            </Border>
            <TextBlock Text="{l:Loc Grid_HintPin}" FontSize="12" Foreground="#66FFFFFF" VerticalAlignment="Center" Margin="6,0,20,0" />

            <Border Padding="6,2" CornerRadius="4" BorderBrush="#59F5B301" BorderThickness="1" Background="#14F5B301" VerticalAlignment="Center">
                <TextBlock Text="Esc" FontSize="11" Foreground="#CCFFD97A" />
            </Border>
            <TextBlock x:Name="EscHintText" Text="Close" FontSize="12" Foreground="#66FFFFFF" VerticalAlignment="Center" Margin="6,0,0,0" />
        </StackPanel>

        <!-- Pin/remove confirm modal layer: covers the whole overlay; Enter confirms, Esc cancels -->
        <Grid x:Name="ConfirmOverlay" Visibility="Collapsed" Background="#6610131A"
              MouseLeftButtonDown="OnConfirmBackdropClick">
            <Border Width="440" HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="14" Background="#F214161D"
                    BorderBrush="#59F5B301" BorderThickness="1" Padding="22,18"
                    MouseLeftButtonDown="OnConfirmDialogClick">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="32" ShadowDepth="12" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="ConfirmMessage" FontSize="14" Foreground="#E6FFFFFF"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Border x:Name="ConfirmYes" Padding="16,6" Margin="0,0,10,0" CornerRadius="8"
                                Background="#26F5B301" BorderBrush="#80F5B301" BorderThickness="1"
                                Cursor="Hand" MouseLeftButtonUp="OnConfirmYesClick">
                            <TextBlock x:Name="ConfirmYesText" Text="Remove" FontSize="12" Foreground="#FFFFD97A" />
                        </Border>
                        <Border x:Name="ConfirmNo" Padding="16,6" CornerRadius="8"
                                Background="#14FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                                Cursor="Hand" MouseLeftButtonUp="OnConfirmNoClick">
                            <TextBlock x:Name="ConfirmNoText" Text="Cancel" FontSize="12" Foreground="#BFFFFFFF" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
