<UserControl x:Class="HiveMotion.HiveCellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="132" Height="152"
             Background="Transparent"
             Cursor="Hand"
             FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei">
    <Grid x:Name="CellRoot">
        <Grid.Effect>
            <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="22" ShadowDepth="10" Direction="90" RenderingBias="Quality" />
        </Grid.Effect>
        <Grid.RenderTransform>
            <TransformGroup>
                <TranslateTransform x:Name="ShiftTransform" X="0" />
                <ScaleTransform x:Name="SearchScaleTransform" CenterX="66" CenterY="76" ScaleX="1" ScaleY="1" />
                <ScaleTransform x:Name="HoverScaleTransform" CenterX="66" CenterY="76" ScaleX="1" ScaleY="1" />
            </TransformGroup>
        </Grid.RenderTransform>

        <!-- 蜂蜜金渐变描边层 -->
        <Path Data="M 66,0 L 132,38 132,114 66,152 0,114 0,38 Z">
            <Path.Fill>
                <LinearGradientBrush StartPoint="0.44,0" EndPoint="0.56,1">
                    <GradientStop Color="#F2FFECBE" Offset="0" />
                    <GradientStop Color="#BFF5B301" Offset="0.38" />
                    <GradientStop Color="#8C8C640A" Offset="0.72" />
                    <GradientStop Color="#D9FFD678" Offset="1" />
                </LinearGradientBrush>
            </Path.Fill>
        </Path>

        <!-- 液态玻璃内层 -->
        <Path Data="M 66,1.73 L 130.5,38.86 130.5,113.14 66,150.27 1.5,113.14 1.5,38.86 Z">
            <Path.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#B81E2028" Offset="0" />
                    <GradientStop Color="#D1101218" Offset="1" />
                </LinearGradientBrush>
            </Path.Fill>
        </Path>

        <Grid IsHitTestVisible="False">
            <Grid.Clip>
                <PathGeometry Figures="M 66,1.73 L 130.5,38.86 130.5,113.14 66,150.27 1.5,113.14 1.5,38.86 Z" />
            </Grid.Clip>

            <!-- 应用图标 -->
            <Image x:Name="AppIcon" Width="48" Height="48"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Margin="0,0,0,26" Opacity="0.9"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Stretch="Uniform">
                <Image.RenderTransform>
                    <ScaleTransform x:Name="IconScale" CenterX="24" CenterY="24" ScaleX="1" ScaleY="1" />
                </Image.RenderTransform>
            </Image>
            <TextBlock x:Name="FallbackGlyph" Visibility="Collapsed"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Margin="0,0,0,26" FontSize="30" FontWeight="Bold" Foreground="#66FFFFFF" />

            <!-- 底部压暗,保证文字可读 -->
            <Path Data="M 66,1.73 L 130.5,38.86 130.5,113.14 66,150.27 1.5,113.14 1.5,38.86 Z">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#24FFFFFF" Offset="0" />
                        <GradientStop Color="#1A000000" Offset="0.45" />
                        <GradientStop Color="#BF000000" Offset="1" />
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>

            <!-- 顶部玻璃高光 -->
            <Ellipse Width="79" Height="34" VerticalAlignment="Top" Margin="0,9,0,0" Opacity="0.6">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0" RadiusX="0.6" RadiusY="1.0">
                        <GradientStop Color="#38FFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="0.7" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- 悬停提亮 -->
            <Path x:Name="HoverGlow" Opacity="0"
                  Data="M 66,1.73 L 130.5,38.86 130.5,113.14 66,150.27 1.5,113.14 1.5,38.86 Z"
                  Fill="#12FFFFFF" />
        </Grid>

        <!-- 蜂蜜滴键帽 -->
        <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,12,0,0"
                MinWidth="27" Height="27" Padding="6,0"
                CornerRadius="8" BorderThickness="1" BorderBrush="#B3FFE9B0"
                RenderTransformOrigin="0.5,0.5">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.4,0" EndPoint="0.6,1">
                    <GradientStop Color="#FFE6A3" Offset="0" />
                    <GradientStop Color="#F5B301" Offset="0.55" />
                    <GradientStop Color="#D99300" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#F5B301" Opacity="0.55" BlurRadius="10" ShadowDepth="2" />
            </Border.Effect>
            <Border.RenderTransform>
                <ScaleTransform x:Name="KeycapScale" ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>
            <TextBlock x:Name="KeyText" Text="A" FontSize="13" FontWeight="ExtraBold"
                       Foreground="#3D2C00" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <!-- 标题(截断) -->
        <StackPanel VerticalAlignment="Bottom" Margin="21,0,21,14" IsHitTestVisible="False">
            <TextBlock x:Name="TitleText" FontSize="11" Foreground="#F2FFFFFF"
                       TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="90" />
            <TextBlock x:Name="AppNameText" FontSize="9" Foreground="#CCF5C542"
                       TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="90" />
        </StackPanel>
    </Grid>
</UserControl>
