<UserControl x:Class="HiveMotion.HiveCellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:HiveMotion.Localization"
             Width="132" Height="152"
             Background="Transparent"
             Cursor="Hand"
             FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei">
    <Grid>
        <Grid x:Name="CellRoot">
        <!-- 位图缓存:阴影/渐变一次性光栅化,滑动/缩放/淡出不触发逐帧重绘(修复拖影与卡顿) -->
        <Grid.CacheMode>
            <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="False" />
        </Grid.CacheMode>
        <Grid.Effect>
            <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="22" ShadowDepth="10" Direction="90" RenderingBias="Quality" />
        </Grid.Effect>
        <Grid.RenderTransform>
            <TransformGroup>
                <TranslateTransform x:Name="ShiftTransform" X="0" />
                <ScaleTransform x:Name="SearchScaleTransform" CenterX="66" CenterY="76" ScaleX="1" ScaleY="1" />
                <ScaleTransform x:Name="HoverScaleTransform" CenterX="66" CenterY="76" ScaleX="1" ScaleY="1" />
            </TransformGroup>
        </Grid.RenderTransform>

        <!-- 蜂蜜金渐变描边层 -->
        <Path Data="M 66,0 L 132,38 132,114 66,152 0,114 0,38 Z">
            <Path.Fill>
                <LinearGradientBrush StartPoint="0.44,0" EndPoint="0.56,1">
                    <GradientStop Color="#F2FFECBE" Offset="0" />
                    <GradientStop Color="#BFF5B301" Offset="0.38" />
                    <GradientStop Color="#8C8C640A" Offset="0.72" />
                    <GradientStop Color="#D9FFD678" Offset="1" />
                </LinearGradientBrush>
            </Path.Fill>
        </Path>

        <!-- 液态玻璃内层 -->
        <Path Data="M 66,1.73 L 130.5,38.86 130.5,113.14 66,150.27 1.5,113.14 1.5,38.86 Z">
            <Path.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#B81E2028" Offset="0" />
                    <GradientStop Color="#D1101218" Offset="1" />
                </LinearGradientBrush>
            </Path.Fill>
        </Path>

        <Grid IsHitTestVisible="False">
            <Grid.Clip>
                <PathGeometry Figures="M 66,1.73 L 130.5,38.86 130.5,113.14 66,150.27 1.5,113.14 1.5,38.86 Z" />
            </Grid.Clip>

            <!-- 应用图标:靠近六边形中心 -->
            <Image x:Name="AppIcon" Width="48" Height="48"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Margin="0,0,0,6" Opacity="0.9"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Stretch="Uniform" />

            <!-- 底部压暗,保证文字可读 -->
            <Path Data="M 66,1.73 L 130.5,38.86 130.5,113.14 66,150.27 1.5,113.14 1.5,38.86 Z">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#24FFFFFF" Offset="0" />
                        <GradientStop Color="#1A000000" Offset="0.45" />
                        <GradientStop Color="#BF000000" Offset="1" />
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>

            <!-- 顶部玻璃高光 -->
            <Ellipse Width="79" Height="34" VerticalAlignment="Top" Margin="0,9,0,0" Opacity="0.6">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0" RadiusX="0.6" RadiusY="1.0">
                        <GradientStop Color="#38FFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="0.7" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

        </Grid>
        </Grid>

        <!-- Text layer: kept outside the bitmap cache so hover/search scaling
             re-rasterizes glyphs as vectors every frame instead of stretching a
             cached bitmap, keeping text sharp at any scale. Transforms are bound
             1:1 to CellRoot's transforms so the layers stay in sync. -->
        <Grid IsHitTestVisible="False">
            <Grid.RenderTransform>
                <TransformGroup>
                    <TranslateTransform X="{Binding X, ElementName=ShiftTransform}" />
                    <ScaleTransform CenterX="66" CenterY="76"
                                    ScaleX="{Binding ScaleX, ElementName=SearchScaleTransform}"
                                    ScaleY="{Binding ScaleY, ElementName=SearchScaleTransform}" />
                    <ScaleTransform CenterX="66" CenterY="76"
                                    ScaleX="{Binding ScaleX, ElementName=HoverScaleTransform}"
                                    ScaleY="{Binding ScaleY, ElementName=HoverScaleTransform}" />
                </TransformGroup>
            </Grid.RenderTransform>

            <!-- Caption area, still clipped to the hexagon so text cannot spill -->
            <Grid>
                <Grid.Clip>
                    <PathGeometry Figures="M 66,1.73 L 130.5,38.86 130.5,113.14 66,150.27 1.5,113.14 1.5,38.86 Z" />
                </Grid.Clip>
                <TextBlock x:Name="FallbackGlyph" Visibility="Collapsed"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="0,0,0,6" FontSize="30" FontWeight="Bold" Foreground="#66FFFFFF" />
                <!-- 名称紧跟图标下方,位于六边形腹部宽区(裁剪在六边形内,不溢出) -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,66,0,0">
                    <TextBlock x:Name="CaptionText"
                               HorizontalAlignment="Center" FontSize="11" Foreground="#F2FFFFFF"
                               TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="100" />
                    <TextBlock x:Name="HintText" Text="{l:Loc Cell_ClickToLaunch}" Visibility="Collapsed"
                               HorizontalAlignment="Center" FontSize="8" Foreground="#99FFD97A"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <!-- 蜂蜜滴键帽 -->
            <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,12,0,0"
                    MinWidth="27" Height="27" Padding="6,0"
                    CornerRadius="8" BorderThickness="1" BorderBrush="#B3FFE9B0"
                    RenderTransformOrigin="0.5,0.5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.4,0" EndPoint="0.6,1">
                        <GradientStop Color="#FFE6A3" Offset="0" />
                        <GradientStop Color="#F5B301" Offset="0.55" />
                        <GradientStop Color="#D99300" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#F5B301" Opacity="0.55" BlurRadius="10" ShadowDepth="2" />
                </Border.Effect>
                <TextBlock x:Name="KeyText" Text="A" FontSize="13" FontWeight="ExtraBold"
                           Foreground="#3D2C00" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>

        <!-- 悬停提亮(放在缓存层之外:透明度动画只是廉价混合,不会击穿位图缓存) -->
        <Path x:Name="HoverGlow" Opacity="0" IsHitTestVisible="False"
              Data="M 66,1.73 L 130.5,38.86 130.5,113.14 66,150.27 1.5,113.14 1.5,38.86 Z"
              Fill="#12FFFFFF" />
    </Grid>
</UserControl>
