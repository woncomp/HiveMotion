<Window x:Class="HiveMotion.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HiveMotion"
        Title="HiveMotion"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="0" Top="0">
    <Grid x:Name="RootGrid">
        <local:TaskGridView x:Name="TaskGrid" />
    </Grid>
</Window>
