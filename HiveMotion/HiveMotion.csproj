<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Resources\hive_icon.ico</ApplicationIcon>
    <Version>$(HiveMotionVersion)</Version>
    <AssemblyVersion>$(HiveMotionAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(HiveMotionAssemblyVersion)</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="WPF-UI.Tray" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tray icon source for the WPF-UI NotifyIcon (ImageSource via pack URI). -->
    <Resource Include="Resources\hive_icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- The .NET 10 SDK turns UseWindowsForms into implicit global usings for
         System.Drawing/System.Windows.Forms, which clash with the WPF namespaces
         imported by the code-behind files (Cursors, DragEventArgs, Binding...).
         All WinForms usages in this project import the namespaces explicitly. -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <!--
    app.manifest is a template: @HiveMotionAssemblyVersion@ is replaced with the
    version from Directory.Build.props and the result is generated into the
    intermediate output directory. ApplicationManifest is pointed at the
    generated file so the compiler never sees the raw template.
  -->
  <Target Name="GenerateAppManifest" BeforeTargets="_SetEmbeddedWin32ManifestProperties">
    <PropertyGroup>
      <_AppManifestTemplate>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\app.manifest'))</_AppManifestTemplate>
      <_AppManifestContent>$(_AppManifestTemplate.Replace('@HiveMotionAssemblyVersion@', '$(HiveMotionAssemblyVersion)'))</_AppManifestContent>
      <ApplicationManifest>$(IntermediateOutputPath)app.manifest</ApplicationManifest>
    </PropertyGroup>
    <WriteLinesToFile File="$(ApplicationManifest)"
                      Lines="$(_AppManifestContent)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
  </Target>

</Project>
