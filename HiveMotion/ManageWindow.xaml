<Window x:Class="HiveMotion.ManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:HiveMotion.Localization"
        Title="{l:Loc Manage_Title}" Width="920" Height="620" MinWidth="780" MinHeight="540"
        Background="#F214161D" Foreground="#E6FFFFFF"
        FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei"
        WindowStartupLocation="CenterScreen"
        KeyDown="OnWindowKeyDown">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="#0DFFFFFF" />
            <Setter Property="BorderBrush" Value="#1FFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="FieldStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#E6FFFFFF" />
            <Setter Property="CaretBrush" Value="#F5C542" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="ButtonStyle" TargetType="Border">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#66FFFFFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left navigation -->
        <Border Background="#0F1014" BorderBrush="#1FFFFFFF" BorderThickness="0,0,1,0">
            <StackPanel>
                <TextBlock Text="HiveMotion" FontSize="18" FontWeight="SemiBold"
                           Foreground="#F2FFFFFF" Margin="20,22,20,2" />
                <TextBlock Text="{l:Loc Nav_Subtitle}" FontSize="10" Foreground="#66F5C542" Margin="20,0,20,18" />

                <Border x:Name="NavPins" Padding="12,10" Margin="10,2" CornerRadius="8"
                        Cursor="Hand" MouseLeftButtonUp="OnNavPinsClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{l:Loc Nav_Pins}" FontSize="13" Foreground="#E6FFFFFF" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border x:Name="NavPriority" Padding="12,10" Margin="10,2" CornerRadius="8"
                        Cursor="Hand" MouseLeftButtonUp="OnNavPriorityClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{l:Loc Nav_Priority}" FontSize="13" Foreground="#E6FFFFFF" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border x:Name="NavHotkeys" Padding="12,10" Margin="10,2" CornerRadius="8"
                        Cursor="Hand" MouseLeftButtonUp="OnNavHotkeysClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{l:Loc Nav_Hotkeys}" FontSize="13" Foreground="#E6FFFFFF" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border x:Name="NavGeneral" Padding="12,10" Margin="10,2" CornerRadius="8"
                        Cursor="Hand" MouseLeftButtonUp="OnNavGeneralClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{l:Loc Nav_General}" FontSize="13" Foreground="#E6FFFFFF" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border x:Name="NavAbout" Padding="12,10" Margin="10,2" CornerRadius="8"
                        Cursor="Hand" MouseLeftButtonUp="OnNavAboutClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{l:Loc Nav_About}" FontSize="13" Foreground="#E6FFFFFF" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Content area -->
        <Grid Grid.Column="1" Margin="16">

            <!-- Pins page -->
            <Grid x:Name="PagePins">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Letter overview: drag to reassign letters, click to edit -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="2,0,2,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{l:Loc Pins_Header}" FontSize="12" Foreground="#99F5C542" VerticalAlignment="Center" />
                                <TextBlock Text="{l:Loc Pins_Hint}" FontSize="11"
                                           Foreground="#59FFFFFF" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                            <Border x:Name="ClearPinsButton" Style="{StaticResource ButtonStyle}"
                                    Padding="10,4" HorizontalAlignment="Right"
                                    MouseLeftButtonUp="OnClearPinsClick">
                                <TextBlock Text="{l:Loc Pins_ClearAll}" FontSize="11" Foreground="#BFFFFFFF" />
                            </Border>
                        </Grid>
                        <StackPanel x:Name="LetterRows" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Editor -->
                <Border Style="{StaticResource CardStyle}" Grid.Row="1" Margin="0,12,0,0">
                    <Grid>
                        <TextBlock x:Name="EditorEmpty" Text="{l:Loc Pins_EditorEmpty}"
                                   FontSize="13" Foreground="#40FFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <Grid x:Name="EditorPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Header: icon + name + status -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" CornerRadius="10" Background="#14FFFFFF"
                                        BorderBrush="#26FFFFFF" BorderThickness="1" VerticalAlignment="Top">
                                    <Image x:Name="EditorIcon" Width="32" Height="32"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Padding="5,1" CornerRadius="5" Background="#26F5B301"
                                                BorderBrush="#80F5B301" BorderThickness="1"
                                                VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock x:Name="EditorLetterBadge" Text="N" FontSize="12"
                                                       FontWeight="Bold" Foreground="#FFFFD97A" />
                                        </Border>
                                        <TextBox x:Name="EditorName" Style="{StaticResource FieldStyle}"
                                                 FontSize="15" FontWeight="SemiBold" MinWidth="240"
                                                 LostFocus="OnEditorFieldLostFocus" />
                                    </StackPanel>
                                    <TextBlock x:Name="EditorStatus" Text="" FontSize="11"
                                               Foreground="#66FFFFFF" Margin="2,6,0,0" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{l:Loc Pins_ProgramPath}" Style="{StaticResource LabelStyle}" />
                                <TextBox x:Name="EditorPath" Grid.Column="1" Style="{StaticResource FieldStyle}"
                                         TextChanged="OnEditorPathChanged" LostFocus="OnEditorFieldLostFocus" />
                                <Border x:Name="BrowsePathButton" Grid.Column="2" Style="{StaticResource ButtonStyle}"
                                        Padding="10,5" Margin="8,0,0,0"                                          MouseLeftButtonUp="OnBrowsePathClick">
                                    <TextBlock Text="{l:Loc Common_Browse}" FontSize="12" Foreground="#BFFFFFFF" />
                                </Border>
                            </Grid>
                            <TextBlock x:Name="PathWarning" Grid.Row="2" Text="{l:Loc Pins_PathWarning}"
                                       FontSize="10" Foreground="#E5484D" Visibility="Collapsed" Margin="64,4,0,0" />

                            <Grid Grid.Row="3" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{l:Loc Pins_Arguments}" Style="{StaticResource LabelStyle}" />
                                <TextBox x:Name="EditorArgs" Grid.Column="1" Style="{StaticResource FieldStyle}"
                                         TextChanged="OnEditorArgsChanged" LostFocus="OnEditorFieldLostFocus" />
                            </Grid>

                            <Grid Grid.Row="4" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{l:Loc Pins_WorkingDir}" Style="{StaticResource LabelStyle}" />
                                <TextBox x:Name="EditorCwd" Grid.Column="1" Style="{StaticResource FieldStyle}"
                                         LostFocus="OnEditorFieldLostFocus" />
                                <Border x:Name="BrowseCwdButton" Grid.Column="2" Style="{StaticResource ButtonStyle}"
                                        Padding="10,5" Margin="8,0,0,0"                                          MouseLeftButtonUp="OnBrowseCwdClick">
                                    <TextBlock Text="{l:Loc Common_Browse}" FontSize="12" Foreground="#BFFFFFFF" />
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="5" Margin="0,12,0,0">
                                <TextBlock Text="{l:Loc Pins_CommandLine}" Style="{StaticResource LabelStyle}" />
                                <TextBlock x:Name="EditorPreview" FontSize="12" Foreground="#99FFFFFF"
                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,12,0,0">
                                <Border x:Name="LaunchButton" Style="{StaticResource ButtonStyle}"
                                        Background="#26F5B301" BorderBrush="#80F5B301"
                                        MouseLeftButtonUp="OnLaunchClick">
                                    <TextBlock Text="{l:Loc Pins_Launch}" FontSize="12" Foreground="#FFFFD97A" />
                                </Border>
                                <Border x:Name="DeletePinButton" Style="{StaticResource ButtonStyle}"
                                        Margin="10,0,0,0" BorderBrush="#80E5484D"
                                        MouseLeftButtonUp="OnDeletePinClick">
                                    <TextBlock Text="{l:Loc Pins_Delete}" FontSize="12" Foreground="#FFE5484D" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Priority page -->
            <Grid x:Name="PagePriority" Visibility="Collapsed">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="{l:Loc Priority_Header}" FontSize="12" Foreground="#99F5C542" Margin="2,0,0,4" />
                            <TextBlock Text="{l:Loc Priority_Desc}"
                                       FontSize="11" Foreground="#59FFFFFF" Margin="2,0,0,10" />
                            <StackPanel x:Name="PriorityList" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PriorityInput" Style="{StaticResource FieldStyle}"
                                         KeyDown="OnPriorityInputKeyDown" />
                                <Border Style="{StaticResource ButtonStyle}" Grid.Column="1"
                                        Margin="8,0,0,0" MouseLeftButtonUp="OnAddPriorityClick">
                                    <TextBlock Text="{l:Loc Priority_Add}" FontSize="12" Foreground="#BFFFFFFF" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{l:Loc Priority_Hint}"
                                       FontSize="10" Foreground="#40FFFFFF" Margin="2,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Hotkeys page -->
            <Grid x:Name="PageHotkeys" Visibility="Collapsed">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="{l:Loc Hotkeys_Header}" FontSize="12" Foreground="#99F5C542" Margin="2,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{l:Loc Hotkeys_Current}" FontSize="13" Foreground="#66FFFFFF" VerticalAlignment="Center" />
                                    <Border Padding="10,4" Margin="8,0,0,0" CornerRadius="6"
                                            Background="#26F5B301" BorderBrush="#80F5B301" BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="HotkeyCurrentText" Text="Win+Tab" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="#FFFFD97A" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Grid.Column="1">
                                    <Border Style="{StaticResource ButtonStyle}"
                                            MouseLeftButtonUp="OnRecordHotkeyClick">
                                        <TextBlock x:Name="RecordHotkeyText" Text="Record a new combo…"
                                                   FontSize="12" Foreground="#BFFFFFFF" />
                                    </Border>
                                    <Border Style="{StaticResource ButtonStyle}" Margin="10,0,0,0"
                                            MouseLeftButtonUp="OnResetHotkeyClick">
                                        <TextBlock Text="{l:Loc Hotkeys_Reset}" FontSize="12" Foreground="#BFFFFFFF" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="HotkeyCaptureHint" Text="{l:Loc Hotkeys_CaptureHint}"
                                       FontSize="11" Foreground="#CCFFD97A" Margin="2,10,0,0" Visibility="Collapsed" />
                            <TextBlock x:Name="HotkeyWarning" FontSize="11" Foreground="#E5484D"
                                       Margin="2,6,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:Loc Hotkeys_Behavior}" FontSize="12" Foreground="#99F5C542" Margin="2,0,0,10" />
                            <CheckBox x:Name="PassthroughBox"
                                      Content="{l:Loc Hotkeys_Passthrough}"
                                      FontSize="13" Foreground="#E6FFFFFF" Margin="2,0,0,0"
                                      Checked="OnPassthroughChanged" Unchecked="OnPassthroughChanged" />
                            <TextBlock Text="{l:Loc Hotkeys_PassthroughDesc}"
                                       FontSize="10" Foreground="#40FFFFFF" Margin="24,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- General page -->
            <Grid x:Name="PageGeneral" Visibility="Collapsed">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="{l:Loc General_Startup}" FontSize="12" Foreground="#99F5C542" Margin="2,0,0,10" />
                            <CheckBox x:Name="AutoStartBox" Content="{l:Loc General_AutoStart}" FontSize="13"
                                      Foreground="#E6FFFFFF" Margin="2,0,0,0"
                                       Checked="OnAutoStartChecked" Unchecked="OnAutoStartUnchecked" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:Loc General_Diagnostics}" FontSize="12" Foreground="#99F5C542" Margin="2,0,0,10" />
                            <CheckBox x:Name="VerboseLoggingBox" Content="{l:Loc General_VerboseLogging}" FontSize="13"
                                      Foreground="#E6FFFFFF" Margin="2,0,0,0"
                                      Checked="OnVerboseLoggingChecked" Unchecked="OnVerboseLoggingUnchecked" />
                            <TextBlock Text="{l:Loc General_VerboseLoggingDesc}"
                                       FontSize="10" Foreground="#40FFFFFF" Margin="24,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:Loc General_Language}" FontSize="12" Foreground="#99F5C542" Margin="2,0,0,10" />
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="LangSystemButton" Style="{StaticResource ButtonStyle}"
                                        Padding="12,5" MouseLeftButtonUp="OnLanguageSystemClick">
                                    <TextBlock Text="{l:Loc General_LanguageSystem}" FontSize="12" Foreground="#BFFFFFFF" />
                                </Border>
                                <Border x:Name="LangZhButton" Style="{StaticResource ButtonStyle}"
                                        Padding="12,5" Margin="10,0,0,0" MouseLeftButtonUp="OnLanguageZhClick">
                                    <TextBlock Text="中文" FontSize="12" Foreground="#BFFFFFFF" />
                                </Border>
                                <Border x:Name="LangEnButton" Style="{StaticResource ButtonStyle}"
                                        Padding="12,5" Margin="10,0,0,0" MouseLeftButtonUp="OnLanguageEnClick">
                                    <TextBlock Text="English" FontSize="12" Foreground="#BFFFFFFF" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:Loc General_Data}" FontSize="12" Foreground="#99F5C542" Margin="2,0,0,10" />
                            <TextBlock x:Name="ConfigPathText" FontSize="11" Foreground="#66FFFFFF"
                                       Margin="2,0,0,10" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource ButtonStyle}" MouseLeftButtonUp="OnOpenConfigDirClick">
                                    <TextBlock Text="{l:Loc General_OpenConfigDir}" FontSize="12" Foreground="#BFFFFFFF" />
                                </Border>
                                <Border Style="{StaticResource ButtonStyle}" Margin="10,0,0,0"
                                        MouseLeftButtonUp="OnOpenPinsFileClick">
                                    <TextBlock Text="{l:Loc General_OpenPins}" FontSize="12" Foreground="#BFFFFFFF" />
                                </Border>
                            </StackPanel>
                            <Grid Margin="2,14,0,0">
                                <TextBlock x:Name="HistoryCountText" FontSize="11" Foreground="#66FFFFFF"
                                           VerticalAlignment="Center" />
                                <Border Style="{StaticResource ButtonStyle}" Padding="10,4"
                                        HorizontalAlignment="Right" MouseLeftButtonUp="OnClearHistoryClick">
                                    <TextBlock Text="{l:Loc General_ClearHistory}" FontSize="11" Foreground="#BFFFFFFF" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:Loc General_Backup}" FontSize="12" Foreground="#99F5C542" Margin="2,0,0,10" />
                            <TextBlock Text="{l:Loc General_BackupDesc}"
                                       FontSize="11" Foreground="#59FFFFFF" Margin="2,0,0,10" />
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource ButtonStyle}" MouseLeftButtonUp="OnExportClick">
                                    <TextBlock Text="{l:Loc General_Export}" FontSize="12" Foreground="#BFFFFFFF" />
                                </Border>
                                <Border Style="{StaticResource ButtonStyle}" Margin="10,0,0,0"
                                        MouseLeftButtonUp="OnImportClick">
                                    <TextBlock Text="{l:Loc General_Import}" FontSize="12" Foreground="#BFFFFFFF" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- About page -->
            <Grid x:Name="PageAbout" Visibility="Collapsed">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="HiveMotion" FontSize="20" FontWeight="SemiBold"
                                       Foreground="#F2FFFFFF" Margin="2,0,0,2" />
                            <TextBlock x:Name="VersionText" Text="Version" FontSize="11"
                                       Foreground="#66FFFFFF" Margin="2,0,0,14" />
                            <TextBlock Text="{l:Loc About_Hotkeys}" FontSize="12" Foreground="#99F5C542" Margin="2,0,0,8" />
                            <StackPanel x:Name="CheatsheetList" Margin="2,0,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- History picker (modal) -->
        <Grid x:Name="PickerOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#B310131A"
              MouseLeftButtonDown="OnPickerBackdropClick">
            <Border Width="600" Height="440" CornerRadius="14" Background="#F214161D"
                    BorderBrush="#59F5B301" BorderThickness="1" Padding="18"
                    MouseLeftButtonDown="OnPickerDialogClick">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="32" ShadowDepth="12" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="PickerTitle" Text="Pin to F" FontSize="15" FontWeight="SemiBold"
                               Foreground="#F2FFFFFF" />
                    <TextBox x:Name="PickerSearch" Grid.Row="1" Style="{StaticResource FieldStyle}"
                             Margin="0,10,0,10" TextChanged="OnPickerSearchChanged" />

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PickerList" />
                    </ScrollViewer>

                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <TextBlock Text="{l:Loc Picker_Desc}" FontSize="10"
                                   Foreground="#59FFFFFF" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Border Style="{StaticResource ButtonStyle}" Padding="12,5"
                                    MouseLeftButtonUp="OnPickerManualClick">
                                <TextBlock Text="{l:Loc Picker_Manual}" FontSize="12" Foreground="#BFFFFFFF" />
                            </Border>
                            <Border Style="{StaticResource ButtonStyle}" Padding="12,5" Margin="10,0,0,0"
                                    MouseLeftButtonUp="OnPickerCancelClick">
                                <TextBlock Text="{l:Loc Common_Cancel}" FontSize="12" Foreground="#BFFFFFFF" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Confirm dialog (modal) -->
        <Grid x:Name="ConfirmOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#B310131A"
              MouseLeftButtonDown="OnConfirmBackdropClick">
            <Border Width="420" CornerRadius="14" Background="#F214161D"
                    BorderBrush="#59F5B301" BorderThickness="1" Padding="22,18"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseLeftButtonDown="OnConfirmDialogClick">
                <StackPanel>
                    <TextBlock x:Name="ConfirmMessage" FontSize="14" Foreground="#E6FFFFFF"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Border Style="{StaticResource ButtonStyle}" Background="#26F5B301"
                                BorderBrush="#80F5B301" Padding="16,6" Margin="0,0,10,0"
                                MouseLeftButtonUp="OnConfirmYesClick">
                            <TextBlock Text="{l:Loc Common_Confirm}" FontSize="12" Foreground="#FFFFD97A" />
                        </Border>
                        <Border Style="{StaticResource ButtonStyle}" Padding="16,6"
                                MouseLeftButtonUp="OnConfirmNoClick">
                            <TextBlock Text="{l:Loc Common_Cancel}" FontSize="12" Foreground="#BFFFFFFF" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
