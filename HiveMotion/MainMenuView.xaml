<UserControl x:Class="HiveMotion.MainMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="320" Height="280">
    <Grid>
        <Border Background="#DD1E1E2E"
                 CornerRadius="20"
                 BorderBrush="#FF6B8DF0"
                 BorderThickness="2"
                 Width="200"
                 Height="200"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Effect="{StaticResource GlowEffect}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="1"
                          Text="{Binding IconGlyph}"
                          FontSize="64"
                          HorizontalAlignment="Center"
                          Foreground="White"
                          Margin="0,10,0,0" />

                <TextBlock Grid.Row="2"
                          Text="{Binding DisplayName}"
                          FontSize="18"
                          FontWeight="SemiBold"
                          HorizontalAlignment="Center"
                          Foreground="White"
                          Margin="0,5,0,0" />

                <Border Grid.Row="3"
                         Background="#FF6B8DF0"
                         CornerRadius="10"
                         Width="36"
                         Height="36"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Top"
                         Margin="0,10,0,20">
                    <TextBlock Text="{Binding Key}"
                              FontSize="20"
                              FontWeight="Bold"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Foreground="White" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
