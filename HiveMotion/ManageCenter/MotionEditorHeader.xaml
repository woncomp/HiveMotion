<UserControl x:Class="HiveMotion.ManageCenter.MotionEditorHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:HiveMotion.Localization">
    <!--
      Shared header for every motion kind: icon (click to customize), bound letter,
      editable custom name, kind label + status line, and the delete button.
      Motion kinds cannot customize this area. FieldStyle/ButtonStyle come from the
      hosting window, hence DynamicResource.
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Width="48" Height="48" CornerRadius="10" Background="#14FFFFFF"
                BorderBrush="#26FFFFFF" BorderThickness="1" VerticalAlignment="Top"
                Cursor="Hand" ToolTip="{l:Loc Dialog_SelectCellIcon}"
                MouseLeftButtonUp="OnBrowseIconClick">
            <Grid>
                <Image x:Name="IconImage" Width="32" Height="32"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <Path x:Name="FolderGlyph" Width="26" Height="20" Stretch="Uniform"
                      Fill="#E6FFD97A" Data="M 0.5,2.5 H 5 L 6.5,4 H 13.5 V 11 H 0.5 Z"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Visibility="Collapsed" />
                <Border x:Name="IconClearButton" Width="15" Height="15" CornerRadius="8"
                        Background="#E5484D" BorderBrush="#FFFF8A8E" BorderThickness="1"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Visibility="Collapsed" ToolTip="{l:Loc Motion_ClearIcon}"
                        MouseLeftButtonUp="OnClearIconClick">
                    <TextBlock Text="×" FontSize="12" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="0,-2,0,0" />
                </Border>
            </Grid>
        </Border>

        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <Border Padding="5,1" CornerRadius="5" Background="#26F5B301"
                        BorderBrush="#80F5B301" BorderThickness="1"
                        VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock x:Name="LetterBadge" Text="N" FontSize="12"
                               FontWeight="Bold" Foreground="#FFFFD97A" />
                </Border>
                <TextBox x:Name="NameBox" Style="{DynamicResource FieldStyle}"
                         FontSize="15" FontWeight="SemiBold" MinWidth="240"
                         LostFocus="OnNameLostFocus" />
            </StackPanel>
            <TextBlock x:Name="StatusLine" FontSize="11" Foreground="#66FFFFFF" Margin="2,6,0,0" />
        </StackPanel>

        <Border x:Name="DeleteButton" Grid.Column="2" Style="{DynamicResource ButtonStyle}"
                Padding="10,5" VerticalAlignment="Top" BorderBrush="#80E5484D"
                MouseLeftButtonUp="OnDeleteClick">
            <TextBlock Text="{l:Loc Motion_Delete}" FontSize="11" Foreground="#FFE5484D" />
        </Border>
    </Grid>
</UserControl>
