<Window x:Class="HiveMotion.TrayHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:tray="http://schemas.lepo.co/wpfui/2022/xaml/tray"
        xmlns:l="clr-namespace:HiveMotion.Localization"
        Title="HiveMotionTrayHost" Width="1" Height="1"
        WindowStyle="None" ShowInTaskbar="False" ShowActivated="False"
        Opacity="0" Left="-32000" Top="-32000"
        Background="Transparent">
    <!--
      Never-visible host window: the WPF-UI NotifyIcon is a FrameworkElement that
      registers itself with the shell during OnRender, so it must live inside a
      shown window. ShutdownMode is OnExplicitShutdown, so this window does not
      affect process lifetime.
    -->
    <Grid>
        <tray:NotifyIcon x:Name="TrayIcon"
                         TooltipText="HiveMotion"
                         Icon="pack://application:,,,/Resources/hive_icon.ico"
                         MenuOnRightClick="True"
                         FocusOnLeftClick="False"
                         LeftDoubleClick="OnTrayLeftDoubleClick">
            <tray:NotifyIcon.Menu>
                <ContextMenu>
                    <ui:MenuItem Header="{l:Loc Tray_OpenHive}" Click="OnOpenHiveClick">
                        <ui:MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Apps24" />
                        </ui:MenuItem.Icon>
                    </ui:MenuItem>
                    <ui:MenuItem Header="{l:Loc Tray_Manage}" Click="OnManageClick">
                        <ui:MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Settings24" />
                        </ui:MenuItem.Icon>
                    </ui:MenuItem>
                    <Separator />
                    <ui:MenuItem Header="{l:Loc Tray_Exit}" Click="OnExitClick">
                        <ui:MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Power24" />
                        </ui:MenuItem.Icon>
                    </ui:MenuItem>
                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>
    </Grid>
</Window>
