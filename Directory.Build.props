<Project>

  <!--
    Single source of truth for the HiveMotion version.

    HiveMotionVersion          - package version, e.g. "0.1.3" for a release or
                                 "0.1.3-build-1" during daily development.
    HiveMotionAssemblyVersion  - four-part assembly / file / installer version,
                                 e.g. "0.1.3.0". The fourth component is the
                                 daily-development build number.

    Consumers (do not hardcode version numbers in these files):
      - HiveMotion/HiveMotion.csproj        (Version, AssemblyVersion, FileVersion)
      - HiveMotion/app.manifest             (template, generated at build time)

    Installer builds read these properties via build-publish.bat, which
    forwards HiveMotionVersion to Inno Setup (/DMyAppVersion). Releases must
    keep the git tag in sync with HiveMotionVersion.
  -->
  <PropertyGroup>
    <HiveMotionVersion>0.1.5</HiveMotionVersion>
    <HiveMotionAssemblyVersion>0.1.5.0</HiveMotionAssemblyVersion>
  </PropertyGroup>

</Project>
